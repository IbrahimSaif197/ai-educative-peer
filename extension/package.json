{
  "name": "edupeer",
  "displayName": "EduPeer",
  "description": "A Socratic AI tutor for novice programmers (Python, JavaScript, TypeScript, Java, C, C++, C#, Go, Rust, SQL).",
  "version": "1.6.0",
  "publisher": "edupeer",
  "license": "GPL-3.0-or-later",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/IbrahimSaif197/ai-educative-peer.git"
  },
  "homepage": "https://github.com/IbrahimSaif197/ai-educative-peer#readme",
  "bugs": {
    "url": "https://github.com/IbrahimSaif197/ai-educative-peer/issues"
  },
  "galleryBanner": {
    "color": "#0d1b2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "education",
    "tutor",
    "socratic",
    "learning",
    "beginner"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "edupeer-sidebar",
          "title": "EduPeer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "edupeer-sidebar": [
        {
          "type": "webview",
          "id": "edupeer.sidebar",
          "name": "EduPeer Tutor"
        }
      ]
    },
    "commands": [
      {
        "command": "edupeer.activate",
        "title": "EduPeer: Open Tutor Panel"
      },
      {
        "command": "edupeer.analyseSelection",
        "title": "EduPeer: Analyse Selection"
      },
      {
        "command": "edupeer.resetSession",
        "title": "EduPeer: Reset Session"
      },
      {
        "command": "edupeer.nudgeLine",
        "title": "EduPeer: Nudge Current Line"
      },
      {
        "command": "edupeer.scanFile",
        "title": "EduPeer: Scan This Block"
      },
      {
        "command": "edupeer.reflectQuiz",
        "title": "EduPeer: Reflection Quiz on My Fix"
      },
      {
        "command": "edupeer.explainError",
        "title": "EduPeer: Explain This Error"
      },
      {
        "command": "edupeer.explainSelection",
        "title": "EduPeer: Explain This Construct"
      },
      {
        "command": "edupeer.predictOutput",
        "title": "EduPeer: Predict the Output"
      },
      {
        "command": "edupeer.traceCode",
        "title": "EduPeer: Trace This Code"
      },
      {
        "command": "edupeer.discussLines",
        "title": "EduPeer: Discuss Flagged Lines"
      },
      {
        "command": "edupeer.showProgress",
        "title": "EduPeer: Show My Progress"
      },
      {
        "command": "edupeer.setGoal",
        "title": "EduPeer: Set Learning Goal"
      },
      {
        "command": "edupeer.signIn",
        "title": "EduPeer: Sign In"
      },
      {
        "command": "edupeer.signOut",
        "title": "EduPeer: Sign Out"
      },
      {
        "command": "edupeer.deepenLine",
        "title": "EduPeer: Go Deeper on This Line"
      },
      {
        "command": "edupeer.dismissLine",
        "title": "EduPeer: Dismiss This Line Hint"
      },
      {
        "command": "edupeer.pickDefinition",
        "title": "EduPeer: Ask About a Definition"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "edupeer.analyseSelection",
          "when": "editorHasSelection && resourceLangId =~ /^(python|javascript|typescript|java|c|cpp|csharp|go|rust|sql)$/",
          "group": "edupeer"
        },
        {
          "command": "edupeer.nudgeLine",
          "when": "resourceLangId =~ /^(python|javascript|typescript|java|c|cpp|csharp|go|rust|sql)$/",
          "group": "edupeer"
        },
        {
          "command": "edupeer.scanFile",
          "when": "resourceLangId =~ /^(python|javascript|typescript|java|c|cpp|csharp|go|rust|sql)$/",
          "group": "edupeer"
        },
        {
          "command": "edupeer.explainSelection",
          "when": "editorHasSelection && resourceLangId =~ /^(python|javascript|typescript|java|c|cpp|csharp|go|rust|sql)$/",
          "group": "edupeer"
        },
        {
          "command": "edupeer.predictOutput",
          "when": "editorHasSelection && resourceLangId =~ /^(python|javascript|typescript|java|c|cpp|csharp|go|rust|sql)$/",
          "group": "edupeer"
        },
        {
          "command": "edupeer.explainError",
          "when": "resourceLangId =~ /^(python|javascript|typescript|java|c|cpp|csharp|go|rust|sql)$/",
          "group": "edupeer"
        },
        {
          "command": "edupeer.traceCode",
          "when": "resourceLangId =~ /^(python|javascript|typescript|java|c|cpp|csharp|go|rust|sql)$/",
          "group": "edupeer"
        }
      ],
      "commandPalette": [
        {
          "command": "edupeer.discussLines",
          "when": "false"
        },
        {
          "command": "edupeer.deepenLine",
          "when": "false"
        },
        {
          "command": "edupeer.dismissLine",
          "when": "false"
        },
        {
          "command": "edupeer.pickDefinition",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "edupeer.nudgeLine",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus && resourceLangId =~ /^(python|javascript|typescript|java|c|cpp|csharp|go|rust|sql)$/"
      }
    ],
    "walkthroughs": [
      {
        "id": "edupeer.gettingStarted",
        "title": "Get started with EduPeer",
        "description": "EduPeer asks questions instead of writing your code. Here's how to get the most out of it.",
        "steps": [
          {
            "id": "edupeer.step.openFile",
            "title": "Open something you're stuck on",
            "description": "EduPeer reads the file you're editing. Open any Python, JavaScript, TypeScript, Java, C, C++, C#, Go, Rust or SQL file — the demos folder has a buggy sample for each.\n[Open the tutor panel](command:edupeer.activate)",
            "media": {
              "markdown": "media/walkthrough/open-file.md"
            }
          },
          {
            "id": "edupeer.step.ask",
            "title": "Ask, then say what you tried",
            "description": "Describe what you expected and what happened. EduPeer replies with a question. Asking again without changing anything keeps you at the same depth — editing the code is what unlocks a deeper hint.\n[Open the tutor panel](command:edupeer.activate)",
            "media": {
              "markdown": "media/walkthrough/ask.md"
            }
          },
          {
            "id": "edupeer.step.inline",
            "title": "Watch the margins",
            "description": "EduPeer flags suspicious lines in the Problems panel and offers a nudge beside the line you're editing. Press Ctrl+Alt+H (Cmd+Alt+H on Mac) for a hint on the current line.",
            "media": {
              "markdown": "media/walkthrough/inline.md"
            }
          },
          {
            "id": "edupeer.step.progress",
            "title": "Check what you're building",
            "description": "Your dashboard shows which concepts keep needing deep hints, your streak and daily activity, and when a spaced review is ready.\n[Show my progress](command:edupeer.showProgress)",
            "media": {
              "markdown": "media/walkthrough/progress.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "EduPeer",
      "properties": {
        "edupeer.backendUrl": {
          "type": "string",
          "default": "https://edupeer-backend.onrender.com",
          "description": "URL of the EduPeer FastAPI backend. Point this at http://localhost:8000 to run against a backend on your own machine."
        },
        "edupeer.inlineHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inline Socratic hints beside the line you're editing."
        },
        "edupeer.lensMode": {
          "type": "string",
          "enum": [
            "top8",
            "flagged"
          ],
          "enumDescriptions": [
            "Offer a hint on the eight largest definitions, plus one entry on line 1 for the rest, and show flagged lines.",
            "Only show lines EduPeer has actually flagged."
          ],
          "default": "top8",
          "description": "Which CodeLens entries EduPeer shows above your code. \"top8\" replaces the old \"all\", which put a lens on every definition and made the gutter unusable on a large file; an existing \"all\" is read as \"top8\". Set edupeer.inlineHints to false to turn the inline surface off entirely."
        },
        "edupeer.removeFixedBugComments": {
          "type": "boolean",
          "default": true,
          "description": "When a file stops being flagged, delete any comment that starts with \"bug:\" — the note described a bug you have already fixed. This is the only time EduPeer edits your code; undo puts it back."
        },
        "edupeer.autoScan": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan your file and flag suspicious lines (Problems panel + gutter)."
        },
        "edupeer.debounceMs": {
          "type": "number",
          "default": 1800,
          "minimum": 600,
          "description": "Idle time (ms) before EduPeer asks for a line-level hint."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node -e \"fs.rmSync('out',{recursive:true,force:true})\" && npm run esbuild -- --minify",
    "esbuild": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "vsce package --no-dependencies",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.4.0"
  }
}
