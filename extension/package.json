{
  "name": "edupeer",
  "displayName": "EduPeer",
  "description": "A Socratic AI tutor for novice Python programmers.",
  "version": "1.0.0",
  "publisher": "edupeer",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Education", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "edupeer-sidebar",
          "title": "EduPeer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "edupeer-sidebar": [
        {
          "type": "webview",
          "id": "edupeer.sidebar",
          "name": "EduPeer Tutor"
        }
      ]
    },
    "commands": [
      {
        "command": "edupeer.activate",
        "title": "EduPeer: Open Tutor Panel"
      },
      {
        "command": "edupeer.analyseSelection",
        "title": "EduPeer: Analyse Selection"
      },
      {
        "command": "edupeer.resetSession",
        "title": "EduPeer: Reset Session"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "edupeer.analyseSelection",
          "when": "editorHasSelection && resourceLangId == python",
          "group": "edupeer"
        }
      ]
    },
    "configuration": {
      "title": "EduPeer",
      "properties": {
        "edupeer.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the EduPeer FastAPI backend."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "jest --passWithNoTests"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.4.0"
  }
}
