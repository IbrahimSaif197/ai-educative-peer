# The tutor runs on Anthropic (claude-haiku-4-5).
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional. Only read when ANTHROPIC_API_KEY is absent, so the service keeps
# answering while the key is rolled out. Safe to delete once it is set.
GROQ_API_KEY=your-groq-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENTS\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Firebase web-app config (public values) — Console > Project settings > Your apps > Web app
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
